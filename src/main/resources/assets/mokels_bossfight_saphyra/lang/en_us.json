  "item.mokels_bossfight_saphyra.sigil_of_the_red_sun_stage_3": "Sigil of the Red Sun",
  "item.mokels_bossfight_saphyra.sigil_of_the_red_sun_stage_2": "Sigil of the Red Sun",
  "dialogue.mokels_bossfight_saphyra.linara.meet.1": "???: Greetings,",
  "dialogue.mokels_bossfight_saphyra.linara.meet.2": "Linara: I am Linara, one of the many scions of the children of aenthir",
  "dialogue.mokels_bossfight_saphyra.linara.meet.3": "Linara: Thou wert cast into this realm with a purpose.",
  "dialogue.mokels_bossfight_saphyra.linara.meet.4": "Linara: We are both of like kind.",
  "dialogue.mokels_bossfight_saphyra.linara.meet.5": "Linara: Led by the grace of the white flame.",
  "dialogue.mokels_bossfight_saphyra.linara.meet.6": "Linara: Alas, our encounter is blessed with fleeting attention.",
  "dialogue.mokels_bossfight_saphyra.linara.meet.7": "Linara: Here, take this invitation and show it to my mistress.",
  "dialogue.mokels_bossfight_saphyra.linara.meet.8": "Linara: She awaits thy arrival in the main hallowed tower.",
  "dialogue.mokels_bossfight_saphyra.linara.meet.9": "Linara: farewell.",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.1": "Linara: Hello again",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.2": "Linara: I watched thou fight against the Nameless Gatekeeper",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.3": "Linara: greatly done",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.4": "Linara: However...",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.5": "Linara: The wind whispers to me. ",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.6": "Linara: His rotten mind still taints the canvas of our world",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.7": "Linara: ...",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.8": "Linara: could thee go back to the church of the oath pus for me?",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.9": "Linara: I bear the key to a treasure room",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.10": "Linara: bring me the \"Manic Eye\"",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.11": "Linara: Thy payment shall be the rest of the treasure.",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.12": "Linara: Here, take the key",
  "dialogue.mokels_bossfight_saphyra.linara.tower1.13": "Linara: I shall wait here for thee to return",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.1": "Linara: I bid thee for forgiveness",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.2": "Linara: My goal was to find out how resistant thou are against the vile curse called manic",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.3": "Linara: And here thee standeth before me.",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.4": "Linara: Without loosing your mind",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.5": "Linara: So resistant...",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.6": "Linara: So powerful...",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.7": "Linara: I have to go now.",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.8": "Linara: My duty is needed elsewhere.",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.9": "Linara: May we meet again.",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.10": "Linara: Please...",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.11": "Linara: Do not give up...",
  "dialogue.mokels_bossfight_saphyra.linara.tower2.12": "Linara: I believe in thou...",
  "dialogue.mokels_bossfight_saphyra.marlene.good": "Marlene: Good...",
  "dialogue.mokels_bossfight_saphyra.marlene.as_promised": "Marlene: As promised, i shall convert the memory you achieved.",
  "dialogue.mokels_bossfight_saphyra.marlene.just_hand_it_over": "Marlene: Just Hand it over.",
  "dialogue.mokels_bossfight_saphyra.marlene.who_art_thou": "Marlene: Who art thou?",
  "dialogue.mokels_bossfight_saphyra.marlene.did_mother_send": "Marlene: Did mother send thee forth?",
  "dialogue.mokels_bossfight_saphyra.marlene.ellipsis": "Marlene: ...",
  "dialogue.mokels_bossfight_saphyra.marlene.good_soft": "Marlene: good...",
  "dialogue.mokels_bossfight_saphyra.marlene.well": "Marlene: well...",
  "dialogue.mokels_bossfight_saphyra.marlene.sense_memory": "Marlene: i sense thou got your hold on a memory?",
  "dialogue.mokels_bossfight_saphyra.marlene.shall_convert": "Marlene: I shall convert it,",
  "dialogue.mokels_bossfight_saphyra.marlene.offer_help": "Marlene: but only if thou offer me thy help first.",
  "dialogue.mokels_bossfight_saphyra.marlene.scholar": "Marlene: I am a scholar of the written word, a seeker of forgotten lore",
  "dialogue.mokels_bossfight_saphyra.marlene.bring_book": "Marlene: Bring me a book, a tale I have not yet encountered.",
  "dialogue.mokels_bossfight_saphyra.marlene.return_grant": "Marlene: When thou hast found it, return to me, and I shall grant thy wish.",
  "dialogue.mokels_bossfight_saphyra.marlene.head_observatory": "Marlene: Thee should head to the observatory",
  "dialogue.mokels_bossfight_saphyra.marlene.mother_wishes": "Marlene: Mother wishes to test thy strength in a duel.",
  "dialogue.mokels_bossfight_saphyra.marlene.take_this_key": "Marlene: Take this key",
  "dialogue.mokels_bossfight_saphyra.marlene.good_luck": "Marlene: I wish thee good luck...",
  "dialogue.mokels_bossfight_saphyra.saphyra.at_last": "Saphyra: At last, I have found one, enduring enough to confront the horrors that linger within this world",
  "dialogue.mokels_bossfight_saphyra.saphyra.forgive_me": "Saphyra: forgive me...",
  "dialogue.mokels_bossfight_saphyra.saphyra.burden": "Saphyra: Though I regret placing this burden upon thee, know that thou art the chosen one to end our suffering.",
  "dialogue.mokels_bossfight_saphyra.saphyra.well_done": "Saphyra: well done,",
  "dialogue.mokels_bossfight_saphyra.saphyra.earned_respect": "Saphyra: Thee earned respect.",
  "dialogue.mokels_bossfight_saphyra.saphyra.possess_memory": "Saphyra: Thou art in possession of his memory, I perceive.",
  "dialogue.mokels_bossfight_saphyra.saphyra.talk_marlene": "Saphyra: Talk to Marlene.",
  "dialogue.mokels_bossfight_saphyra.saphyra.student_mine": "Saphyra: She is a student of mine,",
  "dialogue.mokels_bossfight_saphyra.saphyra.convert_past": "Saphyra: And the only one able to convert his past.",
  "dialogue.mokels_bossfight_saphyra.saphyra.take_keys": "Saphyra: Take these keys.",
  "dialogue.mokels_bossfight_saphyra.saphyra.path_room": "Saphyra: It will open the path to her room.",
  "dialogue.mokels_bossfight_saphyra.saphyra.second_level": "Saphyra: She stands upon the second level.",
  "dialogue.mokels_bossfight_saphyra.saphyra.return_to_me": "Saphyra: Once it is done, return to me.",
  "dialogue.mokels_bossfight_saphyra.saphyra.welcome_heart": "Saphyra: Welcome, to the very heart of our universe.",
  "dialogue.mokels_bossfight_saphyra.saphyra.birthplace": "Saphyra: And the birthplace of Meryd and the white flame.",
  "dialogue.mokels_bossfight_saphyra.saphyra.no_hold_back": "Saphyra: I urge thou not to hold back.",
  "dialogue.mokels_bossfight_saphyra.saphyra.let_us_begin": "Saphyra: Well then, let us begin.",
  "dialogue.mokels_bossfight_saphyra.saphyra.very_well": "Saphyra: Very well",
  "dialogue.mokels_bossfight_saphyra.saphyra.stars_align": "Saphyra: May the stars align and take on the form of our new member.",
  "dialogue.mokels_bossfight_saphyra.saphyra.ellipsis": "Saphyra: ...",
  "dialogue.mokels_bossfight_saphyra.saphyra.great_potential": "Saphyra: I sense great potential inside of thee.",
  "dialogue.mokels_bossfight_saphyra.saphyra.will_rival": "Saphyra: And a will to rival the shattered goddess",
  "dialogue.mokels_bossfight_saphyra.saphyra.take_this": "Saphyra: Take this",
  "dialogue.mokels_bossfight_saphyra.saphyra.now_go": "Saphyra: Now go",
  "dialogue.mokels_bossfight_saphyra.saphyra.peril_together": "Saphyra: The path ahead is fraught with peril, but together, we shall overcome.",
  "dialogue.mokels_bossfight_saphyra.saphyra.head_church": "Saphyra: Head to the church of the oath pus and defeat the Nameless Gatekeeper",
  "dialogue.mokels_bossfight_saphyra.saphyra.wait_return": "Saphyra: I will wait here for thee to return.",
  "dialogue.mokels_bossfight_saphyra.saphyra.leader_welcome": "Saphyra: As the leader of the children of aenthir, I welcome thee into my guiding embrace.",
  "dialogue.mokels_bossfight_saphyra.saphyra.hand_invitation": "Saphyra: Hand me the invitation Linara gave thee.",
  "dialogue.mokels_bossfight_saphyra.saphyra.adopt": "Saphyra: And i will gladly adopt thou into my loving care",
